# ─────────────────────────────────────────────────────────────
# SNIIPE Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# Supabase project URL — from Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — from Supabase dashboard → Project Settings → API
# This is the PUBLIC key (safe to expose in frontend code).
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────
# SUPABASE OAUTH SETUP CHECKLIST
# ─────────────────────────────────────────────────────────────
# 1. Supabase Dashboard → Authentication → Providers → Google → Enable
#    - Add your Google OAuth Client ID and Secret
#      (from Google Cloud Console → APIs & Services → Credentials)
#
# 2. Supabase Dashboard → Authentication → URL Configuration:
#    Site URL:      https://your-domain.com
#    Redirect URLs: https://your-domain.com/auth/callback
#                   http://localhost:5173/auth/callback   (for local dev)
#
# 3. Google Cloud Console → OAuth 2.0 Client:
#    Authorised redirect URIs:
#      https://your-project.supabase.co/auth/v1/callback
# ─────────────────────────────────────────────────────────────
